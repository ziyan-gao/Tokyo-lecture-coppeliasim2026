{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Current script",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "cwd": "${fileDirname}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Current script (with arguments)",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "cwd": "${fileDirname}",
      "args": "${command:pickArgs}",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
